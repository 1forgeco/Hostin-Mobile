{
  "name": "hostin-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~57.0.16",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.14",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image-picker": "~57.0.13",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-notifications": "~57.0.14",
    "expo-router": "~57.0.16",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "~19.2.2",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "node scripts/hostin-backend.cjs start && expo start",
    "android": "expo run:android",
    "ios": "node scripts/hostin-backend.cjs start && expo run:ios",
    "web": "expo start --web",
    "backend:start": "node scripts/hostin-backend.cjs start",
    "backend:status": "node scripts/hostin-backend.cjs status",
    "backend:logs": "node scripts/hostin-backend.cjs logs",
    "backend:stop": "node scripts/hostin-backend.cjs stop",
    "postinstall": "node scripts/fix-expo-xcode-26.cjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && expo export --platform web"
  },
  "private": true
}
