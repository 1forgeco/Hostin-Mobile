# Localhost is rewritten to the Mac's LAN address on physical development devices
# and to 10.0.2.2 in the Android emulator. Use HTTPS for preview/production builds.
EXPO_PUBLIC_API_URL=http://localhost:5001/api
EXPO_PUBLIC_ALLOW_PREVIEW=true
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://example.com/privacy
EXPO_PUBLIC_SUPPORT_EMAIL=support@example.com
# Add after the HostIn backend exposes a device-token registration route.
# EXPO_PUBLIC_PUSH_REGISTER_PATH=/devices/push-token
